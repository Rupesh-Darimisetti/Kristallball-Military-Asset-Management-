generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BASE_COMMANDER
  LOGISTICS_OFFICER
}

enum EquipmentCategory {
  WEAPON
  VEHICLE
  AMMUNITION
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
}

enum AuditAction {
  PURCHASE
  TRANSFER
  ASSIGNMENT
  EXPENDITURE
  LOGIN
}

model Base {
  id               Int          @id @default(autoincrement())
  name             String       @db.VarChar(100)
  location         String       @db.VarChar(150)
  users            User[]
  purchases        Purchase[]
  transfersOut     Transfer[]   @relation("SourceBase")
  transfersIn      Transfer[]   @relation("DestinationBase")
  assignments      Assignment[]
  expenditures     Expenditure[]

  @@map("bases")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role
  baseId       Int?      @map("base_id")
  base         Base?     @relation(fields: [baseId], references: [id], onDelete: SetNull)
  transfers    Transfer[]
  auditLogs    AuditLog[]

  @@index([baseId])
  @@map("users")
}

model EquipmentType {
  id           Int               @id @default(autoincrement())
  name         String            @db.VarChar(100)
  category     EquipmentCategory
  purchases    Purchase[]
  transfers    Transfer[]
  assignments  Assignment[]
  expenditures Expenditure[]

  @@map("equipment_types")
}

model Purchase {
  id              Int           @id @default(autoincrement())
  baseId          Int           @map("base_id")
  equipmentTypeId Int           @map("equipment_type_id")
  quantity        Int
  date            DateTime      @default(now())
  createdAt       DateTime      @default(now()) @map("created_at")
  base            Base          @relation(fields: [baseId], references: [id])
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  @@index([baseId])
  @@index([equipmentTypeId])
  @@index([createdAt])
  @@map("purchases")
}

model Transfer {
  id                Int            @id @default(autoincrement())
  sourceBaseId      Int            @map("source_base_id")
  destinationBaseId Int            @map("destination_base_id")
  equipmentTypeId   Int            @map("equipment_type_id")
  quantity          Int
  status            TransferStatus @default(COMPLETED)
  timestamp         DateTime       @default(now())
  initiatedBy       Int            @map("initiated_by")
  sourceBase        Base           @relation("SourceBase", fields: [sourceBaseId], references: [id])
  destinationBase   Base           @relation("DestinationBase", fields: [destinationBaseId], references: [id])
  equipmentType     EquipmentType  @relation(fields: [equipmentTypeId], references: [id])
  initiator         User           @relation(fields: [initiatedBy], references: [id])

  @@index([sourceBaseId])
  @@index([destinationBaseId])
  @@index([equipmentTypeId])
  @@index([timestamp])
  @@map("transfers")
}

model Assignment {
  id              Int           @id @default(autoincrement())
  baseId          Int           @map("base_id")
  equipmentTypeId Int           @map("equipment_type_id")
  personnelName   String        @map("personnel_name") @db.VarChar(100)
  quantity        Int
  assignedAt      DateTime      @default(now()) @map("assigned_at")
  base            Base          @relation(fields: [baseId], references: [id])
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  @@index([baseId])
  @@index([equipmentTypeId])
  @@map("assignments")
}

model Expenditure {
  id              Int           @id @default(autoincrement())
  baseId          Int           @map("base_id")
  equipmentTypeId Int           @map("equipment_type_id")
  quantity        Int
  reason          String?       @db.VarChar(255)
  expendedAt      DateTime      @default(now()) @map("expended_at")
  base            Base          @relation(fields: [baseId], references: [id])
  equipmentType   EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  @@index([baseId])
  @@index([equipmentTypeId])
  @@map("expenditures")
}

model AuditLog {
  id        Int         @id @default(autoincrement())
  userId    Int         @map("user_id")
  action    AuditAction
  details   String
  createdAt DateTime    @default(now()) @map("created_at")
  user      User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
